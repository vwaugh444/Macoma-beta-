# Public URL of this server (used for links, Twilio signature checks, A2A agent card)
PUBLIC_URL=https://your-tunnel.ngrok.app
PORT=3000

# "waitlist" before launch: the homepage ends in a waitlist, sign-up and texting are off,
# and no AI/Twilio/Stripe keys are needed. "live" (or blank) is the full product.
LAUNCH_MODE=
# Places someone moves up per friend who joins with their link
WAITLIST_REFERRAL_BOOST=10
# Show "N owners already waiting" once the list reaches this size
WAITLIST_SHOW_COUNT_FROM=50

# Database. Blank = embedded Postgres in DATA_DIR (dev only). Production: a managed Postgres
# (Neon, Supabase, RDS/Aurora), ideally through a pooler such as PgBouncer.
DATABASE_URL=
DATABASE_POOL_MAX=10
# DATABASE_SSL=false   # only for a local database without TLS
DATA_DIR=data

# Process role. web: pages, sign-in, webhooks. worker: queued jobs + scheduler. all: both.
# At scale run several web processes and several workers against the same database.
ROLE=all
# Jobs one worker process runs at once. They mostly wait on the model, so this can be high.
WORKER_CONCURRENCY=16
# Shown with queue stats at /readyz when sent as "Authorization: Bearer <token>"
OPS_TOKEN=

# Claude
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
# Model calls one process makes at once, and retries on 429/overload (with backoff)
AI_CONCURRENCY=16
ANTHROPIC_MAX_RETRIES=4
# AI_MOCK=1 answers with a canned reply and no API call (load tests only)

# Twilio SMS. Leave blank to run in console mode (outbound texts are printed).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15555550100
# Production: a Messaging Service (number pool, sticky sender, queueing past per-number limits).
# When set, texts go out through it instead of TWILIO_PHONE_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=
DEFAULT_COUNTRY_CODE=1

# Sign-in codes: only these country codes (comma-separated), and at most this many per hour in total
OTP_COUNTRY_CODES=1
OTP_GLOBAL_HOURLY=500
# Proxies in front of the app (a load balancer = 1). Too high lets callers fake their IP.
TRUST_PROXY_HOPS=1
# Morning briefs are spread over this many minutes of each owner's hour
DIGEST_SPREAD_MIN=45

# Require an invite link to join
INVITE_ONLY=false
SUPPORT_EMAIL=support@example.com
DEFAULT_TIMEZONE=America/New_York

# Stripe: Macoma's own billing (subscriptions, trial, reply packs) and Connect (owners' invoices).
# Apple Pay appears automatically on Stripe Checkout and hosted invoice pages.
STRIPE_SECRET_KEY=
# Platform webhook {PUBLIC_URL}/stripe/webhook: checkout.session.completed, customer.subscription.*
STRIPE_WEBHOOK_SECRET=
# Connect webhook {PUBLIC_URL}/stripe/connect-webhook ("events on connected accounts"): invoice.paid
STRIPE_CONNECT_WEBHOOK_SECRET=
# Connect OAuth client id (ca_...), from Stripe Dashboard > Connect > Settings
STRIPE_CONNECT_CLIENT_ID=
# Monthly Price ids for each plan (create the Products in Stripe first)
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_CREW=

# Plans, trial and the margin rule (see src/billing.ts)
TRIAL_DAYS=14
TRIAL_REPLIES=100
TRIAL_CUSTOMER_TEXTS=30
TRIAL_COST_CAP_USD=4
# AI + messaging cost may not exceed this share of what an account pays
MAX_COST_SHARE=0.4
# Model used once an account is over its cost budget; per-plan models are optional
BUDGET_MODEL=claude-haiku-5-5
MODEL_PERSONAL=
MODEL_BUSINESS=
MODEL_CREW=
# Cost estimates for the meter (USD). Check your Twilio contract.
SMS_SEGMENT_USD=0.0083
SMS_CARRIER_FEE_USD=0.004

# Connectors (OAuth). Leave a pair blank to show that connector as "coming soon".
# 32 random bytes: openssl rand -base64 32. Required in production.
TOKEN_ENCRYPTION_KEY=
# ALLOW_DEV_KEY=true       # only for a throwaway test server on a public URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail needs Google's restricted-scope verification + CASA assessment first
GMAIL_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENV=sandbox

# x402: the agent's own wallet, used to pay for x402 APIs and paid A2A agents.
# Use a fresh testnet key. Fund it with Base Sepolia USDC from a faucet.
AGENT_WALLET_PRIVATE_KEY=
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
MAX_SPEND_PER_CALL_USD=0.10
DAILY_BUDGET_USD=1.00

# x402: charge other agents to use Macoma over A2A. Without this (or A2A_FREE=true) A2A is off.
X402_PAY_TO=
A2A_PRICE=$0.01
# A2A_FREE=true            # answer agents for free (still rate-limited and capped)
A2A_DAILY_CAP_USD=5
A2A_PER_IP_HOURLY=30
