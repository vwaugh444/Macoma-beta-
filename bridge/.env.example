# The domain pointing at this VM (an A record), e.g. agent.yourdomain.com
AGENT_DOMAIN=agent.yourdomain.com
PUBLIC_URL=https://agent.yourdomain.com
AGENT_NAME=Grok

# Model. xAI's API is OpenAI-compatible: https://api.x.ai/v1 with a key from console.x.ai.
# Any other OpenAI-style endpoint works too (OpenAI, OpenRouter, a local server on this VM).
MODEL_BASE_URL=https://api.x.ai/v1
MODEL_API_KEY=
# The model id exactly as your provider lists it (check their model list)
MODEL=

# Who may call this agent: a long random string (openssl rand -hex 32).
# Paste the same value as the agent's "Key" in your Macoma workspace.
BRIDGE_TOKEN=
